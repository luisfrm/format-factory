{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Format Factory",
  "version": "0.1.0",
  "identifier": "com.formatfactory.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Format Factory",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0B0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
