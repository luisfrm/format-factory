# Dominio público (canonical, OG, sitemap y JSON-LD).
# No crea DNS: el Custom Domain se añade en el dashboard de Cloudflare.
SITE_URL=https://formatfactory.luisrivas.site

# Opcional: sirve los instaladores desde un bucket R2 con dominio propio.
# La landing usará ${PUBLIC_DOWNLOAD_BASE}/<tag>/<archivo>.
# PUBLIC_DOWNLOAD_BASE=https://downloads.format-factory.example

# Opcional: evita el rate limit de la API de GitHub durante el build.
# GITHUB_TOKEN=
