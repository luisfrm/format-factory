{
  "name": "format-factory-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing estática de Format Factory, desplegada en Cloudflare Workers",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "assets": "node scripts/generate-assets.mjs",
    "check": "astro check",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "cf:dev": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  }
}
