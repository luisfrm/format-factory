---
import Logo from "@/components/Logo.astro";
import Icon from "@/components/Icon.astro";
import { SITE } from "@/consts";
---

<header
  class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md"
>
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-sm"
      aria-label="Format Factory, inicio"
    >
      <Logo size={30} />
      <span class="text-[15px] font-semibold tracking-tight">
        Format Factory
      </span>
    </a>

    <nav
      aria-label="Principal"
      class="hidden items-center gap-7 text-sm md:flex"
    >
      <a class="nav-link" href="/#producto">Producto</a>
      <a class="nav-link" href="/#formatos">Formatos</a>
      <a class="nav-link" href="/#como-funciona">Cómo funciona</a>
      <a class="nav-link" href="/#faq">FAQ</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        class="nav-link hidden items-center gap-2 text-sm sm:inline-flex"
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Format Factory en GitHub"
      >
        <Icon name="github" size={17} />
        <span class="hidden lg:inline">GitHub</span>
      </a>
      <a class="btn btn-primary btn-sm" href="/descargar/">
        Descargar
        <Icon name="arrow-right" size={16} strokeWidth={2} />
      </a>
    </div>
  </div>
</header>
