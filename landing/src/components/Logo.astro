---
interface Props {
  size?: number;
  class?: string;
}

const { size = 30, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex shrink-0 items-center justify-center",
    className,
  ]}
  aria-hidden="true"
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      x="0.75"
      y="0.75"
      width="30.5"
      height="30.5"
      rx="8.25"
      fill="#141822"
    />
    <rect
      x="0.75"
      y="0.75"
      width="30.5"
      height="30.5"
      rx="8.25"
      stroke="rgba(255,255,255,0.14)"
      stroke-width="1.5"
    />
    <path
      d="M8.5 12.25h12.1"
      stroke="#FF4D67"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="m17.4 9.1 3.6 3.15-3.6 3.15"
      stroke="#FF4D67"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M23.5 19.75H11.4"
      stroke="#7BD0FF"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <path
      d="m14.6 16.6-3.6 3.15 3.6 3.15"
      stroke="#7BD0FF"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>
