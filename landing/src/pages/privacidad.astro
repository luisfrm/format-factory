---
import Base from "@/layouts/Base.astro";
import { SITE } from "@/consts";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacidad · Format Factory",
  url: new URL("/privacidad/", Astro.site ?? Astro.url).href,
  inLanguage: "es",
  isPartOf: { "@type": "WebSite", name: SITE.name, url: Astro.site?.href },
};
---

<Base
  title="Privacidad — Format Factory"
  description="Format Factory no recopila datos, no usa cookies y no incluye analítica. La conversión ocurre en tu equipo."
  jsonLd={jsonLd}
>
  <article class="wrap max-w-[760px] py-16 lg:py-24">
    <nav aria-label="Migas de pan" class="font-mono text-[10px] uppercase tracking-[0.1em] text-subtle">
      <a class="transition-colors hover:text-text" href="/">Inicio</a>
      <span class="mx-2 text-line-strong">/</span>
      <span class="text-muted">Privacidad</span>
    </nav>

    <p class="eyebrow mt-8"><span class="dot"></span>Privacidad</p>
    <h1 class="mt-4 text-[clamp(2.2rem,4.5vw,3.2rem)] font-semibold leading-[1.02] tracking-[-0.04em]">
      Ni cookies, ni analítica, ni perfiles.
    </h1>
    <p class="mt-5 text-[17px] leading-relaxed text-muted">
      Esta página existe para descargar una aplicación de escritorio. No hay
      cuentas, formularios, píxeles de seguimiento ni herramientas de
      analítica.
    </p>

    <div class="mt-10 space-y-8 border-t border-line pt-8">
      <section>
        <h2 class="text-[18px] font-semibold tracking-[-0.015em]">La aplicación</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Format Factory convierte archivos en tu equipo. No sube archivos,
          nombres, rutas ni métricas a ningún servidor. La app funciona sin
          conexión y no incluye telemetría.
        </p>
      </section>

      <section>
        <h2 class="text-[18px] font-semibold tracking-[-0.015em]">Esta web</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Es un sitio estático servido por Cloudflare Workers. No instalamos
          cookies ni almacenamiento local. Como cualquier proveedor de
          infraestructura, Cloudflare puede registrar datos técnicos de la
          petición (dirección IP, user-agent, ruta) para operar y proteger el
          servicio. No accedemos a esos registros para crear perfiles.
        </p>
      </section>

      <section>
        <h2 class="text-[18px] font-semibold tracking-[-0.015em]">Enlaces externos</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Los enlaces a GitHub, a los releases y a la documentación te llevan
          a servicios de terceros con sus propias políticas. Las descargas
          alojadas en GitHub se rigen por la política de privacidad de GitHub.
        </p>
      </section>

      <section>
        <h2 class="text-[18px] font-semibold tracking-[-0.015em]">Contacto</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">
          Para cualquier duda sobre privacidad, abre un issue en el
          repositorio o usa el canal privado indicado en{" "}
          <a class="text-link" href={SITE.security} target="_blank" rel="noopener noreferrer">
            SECURITY.md
          </a>.
        </p>
      </section>
    </div>

    <p class="mt-10 font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">
      Última revisión: octubre de 2026
    </p>
  </article>
</Base>
