# Copia este archivo a `.env` para compilar instaladores en local.
#
# La clave privada de firma es lo que permite que la app acepte tus
# actualizaciones. Nunca la subas al repositorio.
#
# Genérala una sola vez con:
#   pnpm tauri signer generate -w ~/.tauri/format-factory.key
#
# Y guárdala en un gestor de contraseñas + copia offline. Si la pierdes,
# no podrás firmar actualizaciones nunca más.

TAURI_SIGNING_PRIVATE_KEY=C:\Users\tu-usuario\.tauri\format-factory.key

# Solo si la clave tiene contraseña.
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
